# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_USERNAME=admin@example.com
# Generate a hash: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('choose-a-strong-password'))"
ADMIN_PASSWORD_HASH=replace-with-the-generated-password-hash
# Local default is SQLite. Set this to your hosted PostgreSQL URL when deploying.
# DATABASE_URL=postgresql://user:password@host:5432/database
# FLASK_ENV=production
# INSTAGRAM_URL=https://instagram.com/your-account
# LINKEDIN_URL=https://linkedin.com/in/your-account
# GITHUB_URL=https://github.com/your-account
